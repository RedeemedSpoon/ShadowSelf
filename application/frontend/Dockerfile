FROM oven/bun:1.4.4

ARG APP_ORIGIN
ARG ONION_ORIGIN
ARG MAIL_DOMAIN
ARG PUBLIC_STRIPE_KEY
ARG CSP_CONNECT_ORIGINS
ARG CSP_SCRIPT_ORIGINS
ARG CSP_FRAME_ORIGINS

ENV APP_ORIGIN=$APP_ORIGIN \
    ONION_ORIGIN=$ONION_ORIGIN \
    MAIL_DOMAIN=$MAIL_DOMAIN \
    PUBLIC_STRIPE_KEY=$PUBLIC_STRIPE_KEY \
    CSP_CONNECT_ORIGINS=$CSP_CONNECT_ORIGINS \
    CSP_SCRIPT_ORIGINS=$CSP_SCRIPT_ORIGINS \
    CSP_FRAME_ORIGINS=$CSP_FRAME_ORIGINS

WORKDIR /app/frontend

COPY frontend/package.json frontend/bun.lock ./

RUN bun install --frozen-lockfile

COPY frontend/ ./

RUN bun run build

EXPOSE 5000

CMD ["bun", "run", "start"]
