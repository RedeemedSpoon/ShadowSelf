# Copy to application/.env. This is the only settings file for the app,
# database, microservices, extension packaging, and maintenance scripts.
# Docker passes each service only its settings. Never commit real credentials.

# Public deployment. Use http://localhost:5000 for local development.
# APP_DOMAINS contains exact comma-separated website names for TLS and redirects.
# ONION_ORIGIN is optional. Deployment rendering requires an HTTPS APP_ORIGIN.
APP_ORIGIN=https://shadowself.io
APP_DOMAINS=shadowself.io,www.shadowself.io
ONION_ORIGIN=http://shadow7sk64geknoyyzsfyjm4rylnknx5pzhfhzkecoggowhitafggqd.onion

# Mail. Official mailboxes are contact@MAIL_DOMAIN and verification@MAIL_DOMAIN.
# Certificate notices go to contact@MAIL_DOMAIN.
# Use independent random mailbox passwords of at least 24 characters.
MAIL_DOMAIN=shadowself.io
MAIL_HOST=mail.shadowself.io
EMAIL_CONTACT=replace-with-random-contact-mailbox-password
EMAIL_VERIFICATION=replace-with-random-verification-mailbox-password

# PostgreSQL. Host and port are for local backend access; Docker sets its own.
# The application and mail roles are fixed as shadowself_app and shadowself_mail.
# Use random credentials. MAIL_DB_PASSWORD requires 24+ base64url characters.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shadowself
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-database-password
APP_DB_PASSWORD=replace-with-random-application-password
MAIL_DB_PASSWORD=replace-with-random-mail-password

# Application encryption and authentication. Use a random secret of 32+ characters.
SECRET_SAUCE=replace-with-random-secret-at-least-32-characters

# Frontend server. Docker sets its own internal backend URL.
BACKEND_URL=http://localhost:3000

# Browser allowlists. Comma-separated exact HTTPS origins, empty unless needed.
# Rebuild after changing these. Monero browser sync needs its node origin here.
# Card billing uses https://api.stripe.com in CONNECT, https://js.stripe.com
# in SCRIPT, and https://js.stripe.com,https://hooks.stripe.com in FRAME.
CSP_CONNECT_ORIGINS=
CSP_SCRIPT_ORIGINS=
CSP_FRAME_ORIGINS=

# Portrait generation. An empty key leaves generation unavailable.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Chain endpoints must implement the current Esplora, Blockscout, and Monero APIs.
# These may point at your own nodes. Use HTTPS without credentials in the URL.
BTC_API=https://mempool.space/api
LTC_API=https://litecoinspace.org/api
ETH_API=https://eth.blockscout.com/api
XMR_NODE=https://xmr-node.cakewallet.com:18081/json_rpc

# Trocador. Its API and checkout URLs are constants; only the key is configured.
TROCADOR_API_KEY=

# Crypto billing uses a Monero watch-only wallet. Leave blank until configured.
# MONERO_PASSWORD encrypts the server's wallet cache, not a user's wallet.
MONERO_ADDRESS=
MONERO_VIEWKEY=
MONERO_PASSWORD=

# Card billing. Empty values leave the integration unavailable.
# Only PUBLIC_STRIPE_KEY may be sent to the browser. Price IDs are Stripe prices.
PUBLIC_STRIPE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MONTHLY_PRICE_ID=
ANNUALLY_PRICE_ID=
LIFETIME_PRICE_ID=

# Optional remote database operations, read by .scripts/database-operations.sh.
# Set the SSH target to user@host and the exact database container name.
# SSH_KEY is an optional absolute private-key path; otherwise SSH uses its defaults.
SHADOWSELF_SSH_TARGET=
SHADOWSELF_DB_CONTAINER=
SSH_KEY=
