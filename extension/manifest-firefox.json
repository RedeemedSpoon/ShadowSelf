{
  "name": "ShadowSelf",
  "short_name": "ShadowSelf",
  "homepage_url": "__APP_ORIGIN__",
  "author": "RedeemedSpoon",
  "description": "Open your ShadowSelf identities from a signed-in tab in this browser window. Network routing is unavailable.",
  "version": "2.0.0",
  "manifest_version": 3,
  "incognito": "spanning",
  "icons": {
    "16": "assets/icons/icon-16x16.png",
    "32": "assets/icons/icon-32x32.png",
    "48": "assets/icons/icon-48x48.png",
    "64": "assets/icons/icon-64x64.png",
    "96": "assets/icons/icon-96x96.png"
  },
  "action": {
    "default_title": "ShadowSelf",
    "default_popup": "user-interface/dashboard/dashboard.html",
    "default_icon": {
      "16": "assets/icons/icon-16x16.png",
      "32": "assets/icons/icon-32x32.png",
      "48": "assets/icons/icon-48x48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "verfication@shadowself.io",
      "strict_min_version": "149.0"
    }
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "host_permissions": [],
  "content_scripts": [{"matches": ["__APP_ORIGIN__/*"], "js": ["content/website.js"], "run_at": "document_start"}],
  "permissions": ["storage", "scripting"]
}
